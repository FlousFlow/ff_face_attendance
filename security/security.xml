<odoo>
    <record id="rule_ff_face_device_company" model="ir.rule">
        <field name="name">Face devices by allowed company</field>
        <field name="model_id" ref="model_ff_face_device"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>
    <record id="rule_ff_face_policy_company" model="ir.rule">
        <field name="name">Face policies by allowed company</field>
        <field name="model_id" ref="model_ff_face_policy"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>
    <record id="rule_ff_face_exception_company" model="ir.rule">
        <field name="name">Face exceptions by allowed company</field>
        <field name="model_id" ref="model_ff_face_exception"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>
    <record id="rule_ff_face_attempt_company" model="ir.rule">
        <field name="name">Face verification audits by allowed company</field>
        <field name="model_id" ref="model_ff_face_attempt"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>
    <record id="rule_ff_face_consent_company" model="ir.rule">
        <field name="name">Face acknowledgment receipts by allowed company</field>
        <field name="model_id" ref="model_ff_face_consent_receipt"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
    </record>
</odoo>
