<odoo>
    <record id="res_groups_privilege_face_attendance" model="res.groups.privilege">
        <field name="name">Face Attendance</field>
        <field name="sequence">35</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_ff_face_user" model="res.groups">
        <field name="name">Face Attendance User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_face_attendance"/>
    </record>

    <record id="group_ff_face_manager" model="res.groups">
        <field name="name">Face Attendance Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_face_attendance"/>
        <field name="implied_ids" eval="[(4, ref('group_ff_face_user'))]"/>
    </record>

    <!-- Preserve the existing HR behavior while making the Face Attendance role visible. -->
    <record id="hr.group_hr_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_ff_face_user'))]"/>
    </record>
    <record id="hr.group_hr_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_ff_face_manager'))]"/>
    </record>

    <record id="rule_ff_face_device_company" model="ir.rule">
        <field name="name">Face devices by allowed company</field>
        <field name="model_id" ref="model_ff_face_device"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ff_face_user'))]"/>
    </record>
    <record id="rule_ff_face_policy_company" model="ir.rule">
        <field name="name">Face policies by allowed company</field>
        <field name="model_id" ref="model_ff_face_policy"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ff_face_user'))]"/>
    </record>
    <record id="rule_ff_face_exception_company" model="ir.rule">
        <field name="name">Face exceptions by allowed company</field>
        <field name="model_id" ref="model_ff_face_exception"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ff_face_user'))]"/>
    </record>
    <record id="rule_ff_face_attempt_company" model="ir.rule">
        <field name="name">Face verification audits by allowed company</field>
        <field name="model_id" ref="model_ff_face_attempt"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ff_face_user'))]"/>
    </record>
    <record id="rule_ff_face_consent_company" model="ir.rule">
        <field name="name">Face acknowledgment receipts by allowed company</field>
        <field name="model_id" ref="model_ff_face_consent_receipt"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ff_face_manager'))]"/>
    </record>
</odoo>
