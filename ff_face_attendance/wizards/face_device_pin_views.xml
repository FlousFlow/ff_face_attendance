<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ff_face_device_pin_wizard" model="ir.ui.view">
        <field name="name">ff.face.device.pin.wizard.form</field>
        <field name="model">ff.face.device.pin.wizard</field>
        <field name="arch" type="xml">
            <form string="Set Kiosk PIN">
                <div class="alert alert-info" role="alert">Set a 4–12 digit PIN. Odoo stores only a salted hash; the PIN is never displayed again.</div>
                <group>
                    <field name="device_id"/>
                    <field name="pin" password="True"/>
                    <field name="pin_confirmation" password="True"/>
                </group>
                <footer>
                    <button name="action_set_pin" type="object" string="Save PIN" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
