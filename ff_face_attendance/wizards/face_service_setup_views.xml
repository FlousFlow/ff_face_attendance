<odoo>
    <record id="view_face_service_setup_wizard" model="ir.ui.view">
        <field name="name">face.service.setup.wizard.form</field>
        <field name="model">face.service.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Connect Face Service">
                <field name="service_connected" invisible="True"/>
                <div class="alert alert-success" role="alert" invisible="not service_connected">
                    The face service is already connected and ready at <field name="service_url" readonly="True" class="oe_inline"/>. Face attendance remains disabled until an HR manager enables a company policy.
                </div>
                <div class="alert alert-info" role="alert" invisible="service_connected">
                    Run the included server installer on the same Ubuntu server as Odoo. It installs the private face service and shows one setup code. Paste that code here; Odoo stores the connection securely and checks service readiness.
                </div>
                <div class="alert alert-warning" role="alert">
                    The service stays on this server. Face attendance remains disabled until an HR manager enables a company policy. Keep Badge/PIN attendance available.
                </div>
                <group>
                    <field name="pairing_code" password="True" placeholder="Paste the one-time setup code" invisible="service_connected"/>
                </group>
                <footer>
                    <button name="action_connect" type="object" string="Connect service" class="btn-primary" invisible="service_connected"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_face_service_setup_wizard" model="ir.actions.act_window">
        <field name="name">Connect Face Service</field>
        <field name="res_model">face.service.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_face_service_setup_wizard"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_face_service_setup" name="Connect Face Service"
              parent="ff_face_attendance.menu_ff_face_root"
              action="action_face_service_setup_wizard"
              groups="hr.group_hr_manager" sequence="50"/>
</odoo>
