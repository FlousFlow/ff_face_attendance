<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="public_face_kiosk" name="Face Attendance Kiosk">
        <t t-call="web.layout">
            <t t-set="title">Employee attendance</t>
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex,nofollow"/>
                <t t-call-assets="web.assets_frontend" t-js="false"/>
                <t t-call-assets="web.assets_frontend" t-css="false"/>
            </t>
            <t t-set="body">
                <main class="ff-face-kiosk container py-5" aria-labelledby="ff-kiosk-title" t-att-data-local-demo="'true' if local_demo else 'false'" t-att-data-enrollment-only="'true' if enrollment_only else 'false'" t-att-data-admin-mode="'true' if admin_mode else 'false'" t-att-data-requested-employee="requested_employee_id or ''" t-att-lang="kiosk_language" t-att-dir="'rtl' if kiosk_language and kiosk_language.startswith('ar') else 'ltr'">
                    <section class="card shadow-sm mx-auto">
                        <div class="card-body p-4 p-md-5">
                            <nav class="ff-kiosk-language d-flex justify-content-end gap-2 mb-3" aria-label="Language">
                                <a class="btn btn-sm btn-outline-secondary" t-att-href="enrollment_path + '?lang=en_US' + ('&amp;employee_id=%s' % requested_employee_id if requested_employee_id else '')">English</a>
                                <a class="btn btn-sm btn-outline-secondary" t-att-href="enrollment_path + '?lang=ar_001' + ('&amp;employee_id=%s' % requested_employee_id if requested_employee_id else '')">العربية</a>
                            </nav>
                            <h1 id="ff-kiosk-title" class="h2"><t t-if="admin_mode">Face Enrollment — HR Manager</t><t t-else="">Employee attendance</t></h1>
                            <p class="text-muted"><t t-if="admin_mode">Select an employee, obtain consent, and record the supervised face samples from this HR-only page.</t><t t-else="">Stand in front of the camera, center your face in the guide, then follow the movement prompt.</t></p>
                            <div class="alert alert-warning" role="status">Free supervised pilot. Keep Badge/PIN available as the normal fallback.</div>
                            <div class="alert alert-info"><t t-if="admin_mode">This page is restricted to HR managers. Choose the employee below, then click Register face (HR).</t><t t-else="">The kiosk connection is managed by HR. The one-time setup credential is consumed during provisioning and is never shown on this employee registration page. <a href="/ff_face_attendance/native_kiosk">Open the standard Odoo Badge/PIN attendance kiosk</a>.</t></div>
                            <div id="ff-kiosk-lock" class="alert alert-warning d-none" role="alert">
                                <strong>Kiosk locked.</strong> Enter the PIN configured by HR to continue.
                                <div class="input-group mt-2">
                                    <input id="ff-kiosk-pin" class="form-control" type="password" inputmode="numeric" autocomplete="off" maxlength="12"/>
                                    <button id="ff-kiosk-unlock" class="btn btn-primary" type="button">Unlock kiosk</button>
                                </div>
                                <div id="ff-kiosk-pin-status" class="mt-2" role="status"></div>
                            </div>
                            <button id="ff-camera-start" class="btn btn-outline-secondary ms-2" type="button">Check camera</button>
                            <div id="ff-employee-lookup" class="mt-3 ff-employee-lookup position-relative">
                                <label class="form-label" for="ff-employee-search">Employee name</label>
                                <div class="input-group">
                                    <input id="ff-employee-search" class="form-control" type="search" autocomplete="off" placeholder="Search by employee name" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="ff-employee-options"/>
                                    <button id="ff-employee-continue" class="btn btn-primary" type="button" disabled="disabled">Continue</button>
                                </div>
                                <div id="ff-employee-options" class="list-group position-absolute w-100 shadow d-none" role="listbox" style="z-index: 10"/>
                            </div>
                            <p id="ff-employee-name" class="mt-2 fw-semibold d-none"></p>
                            <div id="ff-first-time-enrollment" class="alert alert-info mt-3 d-none">
                                <strong>Face enrollment</strong>
                                <p class="mb-2">The employee must review and acknowledge the notice below before HR starts. Enrollment sends 3–10 camera samples to the configured private face service. Odoo keeps the acknowledgment and enrollment metadata; the service stores encrypted enrollment crops until HR revokes them.</p>
                                <label id="ff-enrollment-consent-wrap" class="form-check d-none">
                                    <input id="ff-enrollment-consent" class="form-check-input" type="checkbox"/>
                                    <span class="form-check-label">The employee has reviewed this notice and agrees to this supervised face pilot. Badge/PIN attendance remains available.</span>
                                </label>
                                <button id="ff-pilot-enroll" class="btn btn-outline-primary mt-2 d-none" type="button">Register face (HR)</button>
                                <p id="ff-hr-enrollment-hint" class="mb-0 mt-2 d-none">Ask an HR manager to register this employee.</p>
                            </div>
                            <div id="ff-revocation-pending" class="alert alert-warning mt-3 d-none" role="status">Face data deletion is still pending. Face attendance is blocked until HR's deletion request is confirmed. Use the standard Badge/PIN kiosk meanwhile.</div>
                            <div id="ff-enrolled-hint" class="text-success mt-3 d-none">
                                <p id="ff-enrolled-hint-text">Your face is registered. Choose Check in or Check out below.</p>
                                <div id="ff-reenroll-controls" class="d-none">
                                    <label class="form-check">
                                        <input id="ff-reenroll-consent" class="form-check-input" type="checkbox"/>
                                        <span class="form-check-label">The employee has reviewed the face-processing notice and agrees to replace the stored samples.</span>
                                    </label>
                                    <button id="ff-pilot-reenroll" class="btn btn-outline-secondary btn-sm mt-2" type="button">Replace face samples (HR)</button>
                                </div>
                            </div>
                            <div class="ff-camera-stage mt-3" t-translation="on">
                                <video id="ff-kiosk-camera" class="d-none" autoplay="autoplay" muted="muted" playsinline="playsinline" aria-label="Camera preview"/>
                                <canvas id="ff-landmark-overlay" class="ff-landmark-overlay d-none" aria-hidden="true"/>
                                <div id="ff-face-guide" class="ff-face-guide" aria-hidden="true"><span><t t-if="kiosk_language and kiosk_language.startswith('ar')">ستظهر الكاميرا بعد المتابعة</t><t t-else="">Camera starts after you continue</t></span></div>
                                <div id="ff-motion-prompt" class="ff-motion-prompt d-none" role="status" aria-live="assertive"></div>
                            </div>
                            <div class="ff-landmark-controls mt-2" t-translation="on">
                                <label class="form-check">
                                    <input id="ff-landmark-consent" class="form-check-input" type="checkbox"/>
                                    <span class="form-check-label"><t t-if="kiosk_language and kiosk_language.startswith('ar')">إظهار نقاط محاذاة الوجه. عند تفعيلها، تُرسل صورة مصغرة واحدة من الكاميرا كل ثانية إلى خدمة الوجه الخاصة، وتُعالج في الذاكرة دون حفظها.</t><t t-else="">Show alignment points. While on, one resized camera frame per second is sent to the configured private face service, processed in memory, and not saved.</t></span>
                                </label>
                                <button id="ff-landmarks-toggle" class="btn btn-outline-secondary btn-sm mt-1" type="button" disabled="disabled">Show face points</button>
                                <span id="ff-landmark-status" class="small text-muted ms-2" role="status" aria-live="polite"><t t-if="kiosk_language and kiosk_language.startswith('ar')">نقاط الوجه متوقفة؛ تظل معاينة الكاميرا داخل هذا المتصفح.</t><t t-else="">Points are off; camera preview stays in this browser.</t></span>
                            </div>
                            <div t-att-class="'ff-attendance-actions mt-3 d-none' if admin_mode else 'ff-attendance-actions mt-3'">
                                <button id="ff-check-in" class="btn btn-success btn-lg" type="button" disabled="disabled">Check in</button>
                                <button id="ff-check-out" class="btn btn-outline-danger btn-lg" type="button" disabled="disabled">Check out</button>
                            </div>
                            <div id="ff-kiosk-status" class="mt-3" role="status" aria-live="polite"></div>
                        </div>
                    </section>
                </main>
            </t>
            <body class="o_web_client">
                <t t-out="body"/>
                <script>document.documentElement.lang = document.querySelector(".ff-face-kiosk")?.getAttribute("lang") || "en_US";</script>
            </body>
        </t>
    </template>
</odoo>
