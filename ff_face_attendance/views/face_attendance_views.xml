<odoo>
    <record id="view_hr_employee_form_face_attendance" model="ir.ui.view">
        <field name="name">hr.employee.form.face.attendance</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Face Attendance" groups="hr.group_hr_manager">
                    <group>
                        <button name="action_open_face_enrollment_kiosk" type="object" string="Open Enrollment Kiosk" class="btn-primary" icon="fa-camera"/>
                        <group>
                            <field name="ff_face_enrollment_status"/>
                            <field name="ff_face_enrolled_at"/>
                            <field name="ff_face_enrollment_operator_id"/>
                            <field name="ff_face_sample_count"/>
                        </group>
                        <group>
                            <field name="ff_face_quality_status"/>
                            <field name="ff_face_model_version"/>
                            <field name="ff_face_template_ref" password="True"/>
                            <button name="action_revoke_face_enrollment" type="object" string="Revoke Enrollment" class="btn-secondary" invisible="ff_face_enrollment_status not in ['enrolled', 'revocation_pending']" confirm="Revoke this biometric enrollment and request deletion of its face samples?"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="ff_face_enrollment_status != 'revocation_pending'">Revocation is pending. Matching is blocked while Odoo retries deletion from the configured face service.</div>
                    <group string="Acknowledgment audit">
                        <field name="ff_face_consent_receipt_ids" nolabel="1">
                            <list create="0" edit="0" delete="0"><field name="acknowledged_at"/><field name="notice_version"/><field name="recorded_by"/></list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_ff_face_policy_list" model="ir.ui.view">
        <field name="name">ff.face.policy.list</field><field name="model">ff.face.policy</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="active"/><field name="biometric_enabled"/><field name="minimum_event_interval_seconds"/></list></field>
    </record>
    <record id="view_ff_face_policy_form" model="ir.ui.view">
        <field name="name">ff.face.policy.form</field><field name="model">ff.face.policy</field>
        <field name="arch" type="xml"><form><sheet><div class="alert alert-warning" role="alert">This enables an experimental supervised face pilot. It does not provide strong liveness or guaranteed photo/video spoof protection. Keep the standard Badge/PIN kiosk available.</div><group><field name="name"/><field name="company_id"/><field name="active"/><field name="biometric_enabled"/><field name="minimum_event_interval_seconds"/><field name="allow_automatic_checkout"/><field name="max_capture_bytes"/></group></sheet></form></field>
    </record>
    <record id="view_ff_face_device_list" model="ir.ui.view">
        <field name="name">ff.face.device.list</field><field name="model">ff.face.device</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="location"/><field name="policy_id"/><field name="active"/><field name="credential_hint"/></list></field>
    </record>
    <record id="view_ff_face_device_form" model="ir.ui.view">
        <field name="name">ff.face.device.form</field><field name="model">ff.face.device</field>
        <field name="arch" type="xml"><form><header><button name="action_revoke" type="object" string="Revoke Device" invisible="not active" confirm="Revoke this kiosk device?"/><button name="action_rotate_credential" type="object" string="Rotate Credential" class="btn-secondary" invisible="not active"/></header><sheet><group><field name="name"/><field name="company_id"/><field name="location"/><field name="policy_id"/><field name="active"/><field name="revoked_at"/><field name="credential_hint"/></group><div class="alert alert-info" role="alert">Device credentials are stored as hashes and must be delivered through a separate secure provisioning workflow.</div></sheet></form></field>
    </record>

    <record id="view_ff_face_exception_list" model="ir.ui.view">
        <field name="name">ff.face.exception.list</field><field name="model">ff.face.exception</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="employee_id"/><field name="company_id"/><field name="reason"/><field name="state"/><field name="create_date"/></list></field>
    </record>
    <record id="view_ff_face_exception_form" model="ir.ui.view">
        <field name="name">ff.face.exception.form</field><field name="model">ff.face.exception</field>
        <field name="arch" type="xml"><form><header><button name="action_start_review" type="object" string="Start Review" invisible="state != 'open'"/><button name="action_resolve" type="object" string="Resolve" invisible="state not in ['open', 'review']"/><button name="action_reject" type="object" string="Reject" invisible="state not in ['open', 'review']"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="employee_id"/><field name="company_id"/><field name="device_id"/><field name="reason"/><field name="details"/><field name="resolution"/></group></sheet><chatter/></form></field>
    </record>

    <record id="view_ff_face_attempt_list" model="ir.ui.view">
        <field name="name">ff.face.attempt.list</field><field name="model">ff.face.attempt</field>
        <field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="create_date"/><field name="device_id"/><field name="company_id"/><field name="employee_id"/><field name="result"/><field name="reason_code"/><field name="model_version"/><field name="attendance_id"/></list></field>
    </record>
    <record id="view_ff_face_attempt_search" model="ir.ui.view">
        <field name="name">ff.face.attempt.search</field><field name="model">ff.face.attempt</field>
        <field name="arch" type="xml"><search><field name="device_id"/><field name="employee_id"/><field name="result"/><filter name="rejected" string="Rejected" domain="[('result', '=', 'rejected')]"/><filter name="errors" string="Service Errors" domain="[('result', '=', 'error')]"/><group><filter name="group_device" string="Device" context="{'group_by': 'device_id'}"/><filter name="group_result" string="Result" context="{'group_by': 'result'}"/><filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/></group></search></field>
    </record>

    <record id="action_ff_face_policy" model="ir.actions.act_window"><field name="name">Face Attendance Policies</field><field name="res_model">ff.face.policy</field><field name="view_mode">list,form</field></record>
    <record id="action_ff_face_device" model="ir.actions.act_window"><field name="name">Face Attendance Devices</field><field name="res_model">ff.face.device</field><field name="view_mode">list,form</field></record>
    <record id="action_ff_face_exception" model="ir.actions.act_window"><field name="name">Face Attendance Exceptions</field><field name="res_model">ff.face.exception</field><field name="view_mode">list,form</field></record>
    <record id="action_ff_face_attempt" model="ir.actions.act_window"><field name="name">Verification Audit</field><field name="res_model">ff.face.attempt</field><field name="view_mode">list</field><field name="search_view_id" ref="view_ff_face_attempt_search"/></record>
    <menuitem id="menu_ff_face_root" name="Face Attendance" web_icon="ff_face_attendance,static/description/icon.png" groups="hr.group_hr_user" sequence="90"/>
    <menuitem id="menu_ff_face_devices" name="Kiosk Devices" parent="menu_ff_face_root" action="action_ff_face_device" groups="hr.group_hr_manager" sequence="10"/>
    <menuitem id="menu_ff_face_policies" name="Policies" parent="menu_ff_face_root" action="action_ff_face_policy" groups="hr.group_hr_manager" sequence="20"/>
    <menuitem id="menu_ff_face_exceptions" name="HR Exceptions" parent="menu_ff_face_root" action="action_ff_face_exception" groups="hr.group_hr_user" sequence="30"/>
    <menuitem id="menu_ff_face_attempts" name="Verification Audit" parent="menu_ff_face_root" action="action_ff_face_attempt" groups="hr.group_hr_manager" sequence="40"/>
</odoo>
