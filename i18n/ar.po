#. module: ff_face_attendance
#: code:addons/ff_face_attendance/models/hr_employee.py:0
#: code:addons/ff_face_attendance/models/face_session.py:0
msgid "Accepted"
msgstr "مقبول"

#. module: ff_face_attendance
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.view_hr_employee_form_face_attendance:0
msgid "Acknowledgment audit"
msgstr "سجل إقرارات الموظف"

#. module: ff_face_attendance
#: code:addons/ff_face_attendance/models/face_consent.py:0
msgid "Acknowledgment receipts are immutable."
msgstr "إيصالات الإقرار محفوظة ولا يمكن تعديلها."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Adjusting the face guide…"
msgstr "جارٍ ضبط دليل الوجه…"

#. module: ff_face_attendance
#: code:addons/ff_face_attendance/models/hr_employee.py:0
msgid "Archived employees cannot use the face enrollment kiosk."
msgstr "لا يمكن للموظفين المؤرشفين استخدام شاشة تسجيل الوجه."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Ask HR to connect this kiosk first."
msgstr "اطلب من الموارد البشرية ربط هذا الكشك أولًا."

#. module: ff_face_attendance
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.public_face_kiosk:0
msgid "Ask an HR manager to register this employee."
msgstr "اطلب من مدير الموارد البشرية تسجيل هذا الموظف."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid ""
"Ask the employee to review the notice and confirm before capturing any "
"samples."
msgstr "اطلب من الموظف قراءة الإشعار والإقرار به قبل التقاط أي صور."

#. module: ff_face_attendance
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Attendance requires HR review"
msgstr "تسجيل الحضور يحتاج إلى مراجعة الموارد البشرية"

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Attendance verification failed. Please retry or use Badge/PIN."
msgstr "فشل التحقق من الحضور. حاول مرة أخرى أو استخدم البطاقة أو الرقم السري."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Attendance was already recorded. Please wait before trying again."
msgstr "تم تسجيل الحضور بالفعل. انتظر قليلًا قبل المحاولة مجددًا."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Camera permission was denied."
msgstr "تم رفض إذن استخدام الكاميرا."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.public_face_kiosk:0
msgid "Camera preview"
msgstr "معاينة الكاميرا"

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid ""
"Camera preview is local to this browser. Choose Register face, Check in, or "
"Check out to send the prompted samples."
msgstr ""
"معاينة الكاميرا محلية في هذا المتصفح. اختر تسجيل الوجه أو الحضور أو الانصراف"
" لإرسال الصور المطلوبة فقط."

#. module: ff_face_attendance
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.public_face_kiosk:0
msgid "Camera starts after you continue"
msgstr "ستبدأ الكاميرا بعد المتابعة"

#. module: ff_face_attendance
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.public_face_kiosk:0
msgid "Check camera"
msgstr "فحص الكاميرا"

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.public_face_kiosk:0
msgid "Check in"
msgstr "تسجيل الحضور"

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.public_face_kiosk:0
msgid "Check out"
msgstr "تسجيل الانصراف"

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Check-in recorded successfully."
msgstr "تم تسجيل الحضور بنجاح."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Check-out recorded successfully."
msgstr "تم تسجيل الانصراف بنجاح."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Connect the kiosk and start the camera before registration."
msgstr "اربط الكشك وشغّل الكاميرا قبل تسجيل الوجه."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Connect the kiosk and start the camera first."
msgstr "اربط الكشك وشغّل الكاميرا أولًا."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Connecting this local kiosk…"
msgstr "جارٍ ربط هذا الكشك المحلي…"

#. module: ff_face_attendance
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.public_face_kiosk:0
msgid "Continue"
msgstr "متابعة"

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Could not check employee registration. Try again or contact HR."
msgstr ""
"تعذر التحقق من تسجيل الموظف. حاول مرة أخرى أو تواصل مع الموارد البشرية."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid ""
"Could not check kiosk pairing. Use the one-time setup credential if needed."
msgstr "تعذر التحقق من ربط الكشك. استخدم رمز الإعداد لمرة واحدة عند الحاجة."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid ""
"Could not connect the local kiosk. Check that one active kiosk is configured"
" for this company."
msgstr "تعذر ربط الكشك المحلي. تحقق من إعداد كشك نشط واحد لهذه الشركة."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Could not search employees. Check the kiosk connection and retry."
msgstr "تعذر البحث عن الموظفين. تحقق من اتصال الكشك وحاول مرة أخرى."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
#: code:addons/ff_face_attendance/models/face_device.py:0
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.view_hr_employee_form_face_attendance:0
msgid "Device"
msgstr "الجهاز"

#. module: ff_face_attendance
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.view_hr_employee_form_face_attendance:0
msgid ""
"Device credentials are stored as hashes and must be delivered through a "
"separate secure provisioning workflow."
msgstr ""
"تُخزن رموز الأجهزة كقيم مشفرة، ويجب تسليمها عبر إجراء إعداد آمن منفصل."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Employee acknowledgment is required before enrollment."
msgstr "يجب إقرار الموظف قبل تسجيل الوجه."

#. module: ff_face_attendance
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.public_face_kiosk:0
msgid "Employee attendance"
msgstr "تسجيل حضور الموظفين"

#. module: ff_face_attendance
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.public_face_kiosk:0
msgid "Employee name"
msgstr "اسم الموظف"

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Employee not found in this company."
msgstr "لم يتم العثور على الموظف في هذه الشركة."

#. module: ff_face_attendance
#: code:addons/ff_face_attendance/models/hr_employee.py:0
msgid "Enrolled"
msgstr "مسجل"

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Enter the one-time credential provided by your HR manager."
msgstr "أدخل رمز الإعداد لمرة واحدة الذي قدمه مدير الموارد البشرية."

#. module: ff_face_attendance
#: code:addons/ff_face_attendance/models/face_device.py:0
#: code:addons/ff_face_attendance/models/face_exception.py:0
#: code:addons/ff_face_attendance/models/hr_employee.py:0
#: code:addons/ff_face_attendance/models/face_session.py:0
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.public_face_kiosk:0
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.view_hr_employee_form_face_attendance:0
msgid "Face Attendance"
msgstr "الحضور بالوجه"

#. module: ff_face_attendance
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.view_hr_employee_form_face_attendance:0
msgid "Face Attendance Devices"
msgstr "أجهزة الحضور بالوجه"

#. module: ff_face_attendance
#: code:addons/ff_face_attendance/models/hr_employee.py:0
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.view_hr_employee_form_face_attendance:0
msgid "Face Attendance Policies"
msgstr "سياسات الحضور بالوجه"

#. module: ff_face_attendance
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.public_face_kiosk:0
msgid ""
"Face data deletion is still pending. Face attendance is blocked until HR's "
"deletion request is confirmed. Use the standard Badge/PIN kiosk meanwhile."
msgstr ""
"ما زال حذف بيانات الوجه قيد التنفيذ. تسجيل الحضور بالوجه متوقف حتى تأكيد طلب"
" الحذف من الموارد البشرية. استخدم شاشة البطاقة أو الرقم السري مؤقتًا."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.public_face_kiosk:0
msgid "Face enrollment"
msgstr "تسجيل الوجه"

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Face enrollment is not available for this employee yet."
msgstr "تسجيل الوجه غير متاح لهذا الموظف حاليًا."

#. module: ff_face_attendance
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Face enrollment is temporarily unavailable."
msgstr "تسجيل الوجه غير متاح مؤقتًا."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Face points unavailable; check the camera or private face service."
msgstr "نقاط الوجه غير متاحة؛ تحقق من الكاميرا أو خدمة الوجه الخاصة."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Face registered. You can check in."
msgstr "تم تسجيل الوجه. يمكنك تسجيل الحضور."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Face registration failed. Keep one face centered and retry."
msgstr "فشل تسجيل الوجه. أبقِ وجهًا واحدًا في المنتصف وحاول مرة أخرى."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Face samples saved for employee %s."
msgstr "تم حفظ صور الوجه للموظف %s."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid ""
"Face samples saved for this employee. Choose Check in or Check out below."
msgstr "تم حفظ صور الوجه لهذا الموظف. اختر تسجيل الحضور أو الانصراف أدناه."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid ""
"Face verification service is temporarily unavailable. No attendance was "
"recorded."
msgstr "خدمة التحقق من الوجه غير متاحة مؤقتًا. لم يتم تسجيل الحضور."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Face-data deletion is pending. Use Badge/PIN meanwhile."
msgstr "حذف بيانات الوجه قيد التنفيذ. استخدم البطاقة أو الرقم السري مؤقتًا."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid ""
"Five face points detected (%s%% detector confidence). Frames are not stored."
msgstr "تم تحديد خمس نقاط للوجه (ثقة الكشف %s%%). لا يتم حفظ الصور."

#. module: ff_face_attendance
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.public_face_kiosk:0
msgid ""
"Free supervised pilot. Keep Badge/PIN available as the normal fallback."
msgstr ""
"تجربة مجانية تحت الإشراف. أبقِ تسجيل الدخول بالبطاقة أو الرقم السري متاحًا "
"كطريقة بديلة."

#. module: ff_face_attendance
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.view_hr_employee_form_face_attendance:0
msgid "HR Exceptions"
msgstr "استثناءات الموارد البشرية"

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Hello, %s"
msgstr "مرحبًا، %s"

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Hide face points"
msgstr "إخفاء نقاط الوجه"

#. module: ff_face_attendance
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid ""
"I could not detect exactly one face. Move closer and keep your full face "
"inside the guide."
msgstr "تعذر تحديد وجه واحد فقط. اقترب وأبقِ وجهك كاملًا داخل الإطار."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid ""
"Keep one face centered. First look straight at the camera, then follow the "
"head-turn prompt to replace the local pilot samples."
msgstr ""
"أبقِ وجهًا واحدًا في منتصف الإطار. انظر أولًا إلى الكاميرا مباشرة، ثم اتبع "
"تعليمات تدوير الرأس لتسجيل صور التجربة."

#. module: ff_face_attendance
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.view_hr_employee_form_face_attendance:0
msgid "Kiosk Devices"
msgstr "أجهزة الكشك"

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Kiosk connected. Search and select your employee name to continue."
msgstr "تم ربط الكشك. ابحث عن اسم الموظف واختره للمتابعة."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid ""
"Kiosk is already connected. Search and select your employee name to "
"continue."
msgstr "الكشك متصل بالفعل. ابحث عن اسم الموظف واختره للمتابعة."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Kiosk setup failed. Check the one-time credential."
msgstr "تعذر إعداد الكشك. تحقق من رمز الإعداد لمرة واحدة."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid ""
"Local kiosk connected. Search and select your employee name to continue."
msgstr "تم ربط الكشك المحلي. ابحث عن اسم الموظف واختره للمتابعة."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Look straight at the camera"
msgstr "انظر مباشرة إلى الكاميرا"

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "No matching employees found."
msgstr "لم يتم العثور على موظفين مطابقين."

#. module: ff_face_attendance
#: code:addons/ff_face_attendance/models/hr_employee.py:0
msgid "Not Enrolled"
msgstr "غير مسجل"

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid ""
"Odoo could not finish attendance verification because of a system error. No "
"attendance was recorded; contact HR before trying again."
msgstr ""
"تعذر على أودو إكمال التحقق من الحضور بسبب خطأ في النظام. لم يتم تسجيل "
"الحضور؛ تواصل مع الموارد البشرية قبل المحاولة مجددًا."

#. module: ff_face_attendance
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.public_face_kiosk:0
msgid "One-time kiosk setup credential"
msgstr "رمز إعداد الكشك لمرة واحدة"

#. module: ff_face_attendance
#: code:addons/ff_face_attendance/models/face_device.py:0
msgid "Only an HR manager can configure biometric policies."
msgstr "يمكن لمدير الموارد البشرية فقط إعداد سياسات القياسات الحيوية."

#. module: ff_face_attendance
#: code:addons/ff_face_attendance/models/hr_employee.py:0
msgid "Only an HR manager can open the face enrollment kiosk."
msgstr "يمكن لمدير الموارد البشرية فقط فتح شاشة تسجيل الوجه."

#. module: ff_face_attendance
#: code:addons/ff_face_attendance/models/face_device.py:0
msgid "Only an HR manager can register a kiosk device."
msgstr "يمكن لمدير الموارد البشرية فقط تسجيل جهاز الكشك."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid ""
"Only an HR manager can register or replace face samples; a pending deletion "
"must finish first."
msgstr ""
"يمكن لمدير الموارد البشرية فقط تسجيل صور الوجه أو استبدالها؛ يجب انتظار "
"اكتمال الحذف أولًا."

#. module: ff_face_attendance
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.view_hr_employee_form_face_attendance:0
msgid "Open Enrollment Kiosk"
msgstr "فتح شاشة تسجيل الوجه"

#. module: ff_face_attendance
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.public_face_kiosk:0
msgid "Open the standard Odoo Badge/PIN attendance kiosk"
msgstr "افتح شاشة أودو القياسية لتسجيل الحضور بالبطاقة أو الرقم السري"

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
#: code:addons/ff_face_attendance/models/hr_employee.py:0
msgid "Pending"
msgstr "قيد الانتظار"

#. module: ff_face_attendance
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.public_face_kiosk:0
msgid "Points are off; camera preview stays in this browser."
msgstr "النقاط متوقفة؛ تظل معاينة الكاميرا داخل هذا المتصفح."

#. module: ff_face_attendance
#. odoo-javascript
#: code:addons/ff_face_attendance/static/src/kiosk.js:0
msgid "Points are off; no camera frames are being sent for alignment."
msgstr "النقاط متوقفة؛ لا تُرسل صور من الكاميرا لمحاذاة الوجه."

#. module: ff_face_attendance
#: code:addons/ff_face_attendance/models/hr_employee.py:0
#: model_terms:ir.ui.view,arch_db:ff_face_attendance.view_hr_employee_form_face_attendance:0
msgid "Policies"
msgstr "السياسات"

#. module: ff_face_attendance
