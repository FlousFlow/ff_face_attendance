FF_LISTEN_HOST=127.0.0.1
FF_LISTEN_PORT=8787
FF_MAX_CAPTURE_BYTES=2000000
FF_ODOO_SHARED_SECRET=replace-with-a-random-request-secret
FF_RESULT_HMAC_SECRET=replace-with-a-different-random-secret
FF_PILOT_ENABLED=false
FF_PILOT_ADMIN_TOKEN=replace-with-a-long-random-enrollment-token
FF_PILOT_GALLERY_DIR=/var/lib/ff-face-ai/pilot-gallery
# Generate a Fernet key and store it outside source control; comma-separate previous keys during rotation.
FF_PILOT_GALLERY_KEYS=
FF_NONCE_DB_PATH=/var/lib/ff-face-ai/nonces.sqlite3
FF_PILOT_DETECTOR_PATH=/opt/ff-face-ai/models/face_detection_yunet_2023mar.onnx
FF_PILOT_THRESHOLD=70
FF_TLS_CERTFILE=/etc/ff-face-ai/server.crt
FF_TLS_KEYFILE=/etc/ff-face-ai/server.key
FF_SETUP_PAIR_CODE_FILE=/var/lib/ff-face-ai/setup-code
FF_SETUP_PAIRED_PATH=/var/lib/ff-face-ai/setup-paired
