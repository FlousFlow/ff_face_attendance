[Unit]
Description=Flous Flow Face Attendance AI service
After=network.target

[Service]
Type=simple
User=ff-face-ai
Group=ff-face-ai
WorkingDirectory=/opt/ff-face-ai
EnvironmentFile=/etc/ff-face-ai/ff-face-ai.env
ExecStart=/opt/ff-face-ai/.venv/bin/python -m ff_face_ai_service.server
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ff-face-ai /var/log/ff-face-ai
MemoryMax=1G
CPUQuota=150%
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target
